{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Respuesta Python a Express v1 (borrador)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "./result.schema.json"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15000
    }
  },
  "required": [
    "data",
    "usage",
    "model",
    "latency_ms"
  ]
}
