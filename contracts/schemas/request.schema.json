{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solicitud Express a Python v1 (borrador)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task": {
      "const": "real_estate_assistance"
    },
    "lane": {
      "enum": [
        "live",
        "batch"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "lead",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          }
        },
        "required": [
          "role",
          "content"
        ]
      }
    },
    "context": {
      "$ref": "./lead-data.schema.json"
    },
    "json_schema": {
      "const": {
        "$ref": "urn:leadqual:ai:result:v1"
      }
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    }
  },
  "required": [
    "task",
    "lane",
    "messages",
    "context",
    "json_schema",
    "max_tokens"
  ]
}
